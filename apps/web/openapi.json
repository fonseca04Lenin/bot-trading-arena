  "/api/bots/{slug}/equity": {
   "get": {
    "summary": "Bot Equity",
    "operationId": "bot_equity_api_bots__slug__equity_get",
    "parameters": [
     {
      "name": "slug",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Slug"
      }
     },
     {
      "name": "range",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "pattern": "^(1D|1W|1M|ALL)$",
       "default": "1D",
       "title": "Range"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true,
         "title": "Response Bot Equity Api Bots  Slug  Equity Get"
        }
