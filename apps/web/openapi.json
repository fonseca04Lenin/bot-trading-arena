      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/trades": {
   "get": {
    "summary": "List Trades",
    "operationId": "list_trades_api_trades_get",
    "parameters": [
     {
      "name": "bot",
      "in": "query",
      "required": false,
