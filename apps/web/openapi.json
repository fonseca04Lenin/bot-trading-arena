 "components": {
  "schemas": {
   "BacktestRequest": {
    "properties": {
     "strategy_slug": {
      "type": "string",
      "enum": [
       "crossover",
       "rubber-band",
       "breakout",
       "index"
      ],
      "title": "Strategy Slug"
     },
     "symbol": {
      "type": "string",
      "title": "Symbol"
     },
     "start": {
      "type": "string",
      "format": "date-time",
      "title": "Start"
     },
     "end": {
      "type": "string",
      "format": "date-time",
      "title": "End"
     },
     "params": {
      "additionalProperties": {
       "type": "number"
      },
      "type": "object",
      "title": "Params"
     }
    },
    "type": "object",
    "required": [
     "strategy_slug",
     "symbol",
     "start",
     "end"
    ],
    "title": "BacktestRequest"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
